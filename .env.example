# Free key from https://www.roic.ai (Sign up → API). Free tier: 5 requests/minute.
ROIC_API_KEY=

# Optional: override the JSE exchange code if `npm run agent:discover` finds a different one.
# ROIC_EXCHANGE=JSE

# Crypto picker (optional key). Free Demo key from https://www.coingecko.com/en/api — without one the agent
# still runs on CoinGecko's keyless limits, just slower.
COINGECKO_API_KEY=
